# Azure authentication is handled via Managed Identity or Azure CLI, not static secrets.
SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-sentinel-lab
WORKSPACE_NAME=law-sentinel-lab
GOOGLE_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=

# CTI Enrichment Thresholds (tunable per environment)
# VT_MALICIOUS_THRESHOLD: minimum number of AV engine detections to classify an IOC
# as "malicious". Default 5. A single engine detection (1/70) is usually a heuristic
# false positive. Increase for high-precision SOCs, decrease only if you accept more FPs.
VT_MALICIOUS_THRESHOLD=5

# ABUSEIPDB_MALICIOUS_THRESHOLD: minimum abuseConfidenceScore to classify an IP as
# "malicious". Score is a Bayesian-weighted aggregate (0-100). Default 75.
# 25-74 = "suspicious" (investigate). <25 = "clean".
ABUSEIPDB_MALICIOUS_THRESHOLD=75