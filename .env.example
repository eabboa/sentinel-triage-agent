# Azure authentication is handled via Managed Identity or Azure CLI, not static secrets.
SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-sentinel-lab
WORKSPACE_NAME=law-sentinel-lab
GOOGLE_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentinel-triage-agent

# CTI Enrichment Thresholds (tunable per environment)
# VT_MALICIOUS_THRESHOLD: minimum number of AV engine detections to classify an IOC
# as "malicious". Default 5. A single engine detection (1/70) is usually a heuristic
# false positive. Increase for high-precision SOCs, decrease only if you accept more FPs.
VT_MALICIOUS_THRESHOLD=5

# ABUSEIPDB_MALICIOUS_THRESHOLD: minimum abuseConfidenceScore to classify an IP as
# "malicious". Score is a Bayesian-weighted aggregate (0-100). Default 75.
# 25-74 = "suspicious" (investigate). <25 = "clean".
ABUSEIPDB_MALICIOUS_THRESHOLD=75

# MITRE ATT&CK STIX enrichment (optional - mitre_enrich_node works with defaults)
# MITRE_STIX_CACHE_DIR: where the Enterprise ATT&CK STIX bundle is cached on disk.
# Defaults to <system temp dir>/sentinel-triage-agent (never the repo root).
# MITRE_STIX_CACHE_DIR=
# MITRE_STIX_CACHE_TTL: bundle refresh interval in seconds. Default 86400 (24h).
MITRE_STIX_CACHE_TTL=86400
# MITRE_STIX_FAILURE_TTL: after a failed download/parse, suppress re-attempts for this
# many seconds to avoid a retry storm across an incident batch. Default 300 (5 min).
MITRE_STIX_FAILURE_TTL=300

# ChromaDB connection (used by analyst_node and learning_node for RAG)
CHROMA_HOST=localhost
CHROMA_PORT=8000